+@pytest.mark.parametrize("dynamic", [False, True])
+def test_large_uncertain_vocabulary_unordered_arena(dynamic):
+    # >128 tokens cross the current entry boundary. Distinct integer spellings merge
+    # into equivalent continuation rows; backtracking must not revive freed seen IDs.
+    tag = native_fields(["a", "b", "c"], {"a", "b"})
+    prefix = '<call><arg key="a">'
+    suffixes = [f'{i}</arg><arg key="{key}">1</arg>' for i in range(100, 300) for key in 'abc']
+    pieces = [prefix] + suffixes + [f'!invalid{i}' for i in range(700)] + ['[EOS]']
+    info = xgr.TokenizerInfo(pieces, stop_token_ids=len(pieces)-1)
+    compiler = xgr.GrammarCompiler(info, enable_dynamic_compilation=dynamic)
+    compiled = compiler.compile_structural_tag(tag)
+    matcher = xgr.GrammarMatcher(compiled)
+    assert matcher.accept_token(0)
+    mask = xgr.allocate_token_bitmask(1, len(pieces))
+    for _ in range(2):
+        matcher.fill_next_token_bitmask(mask)
+        for token, suffix in enumerate(suffixes, 1):
+            expected = 'key="a"' not in suffix
+            assert bool((int(mask[0, token//32]) >> (token%32)) & 1) == expected, suffix
+    # Definitive matching and rollback must agree with all mask probes.
+    assert matcher.accept_token(2)  # a=100, then b=1
+    matcher.rollback(1)
+    matcher.fill_next_token_bitmask(mask)
+    assert not matcher.accept_token(1)  # duplicate a
+    assert matcher.accept_token(3)  # a=100, then c=1
+
