index 0000000000000000000000000000000000000000..31a5f5a47de55b48017e4818b81c2f7d45715fbf
--- /dev/null
+++ b/tests/python/test_phala_discarded_false.py
@@ -0,0 +1,172 @@
+"""Independent discarded-schema regressions, stage on safe3 then safe4.
+
+No model/network calls. Unsupported must be RuntimeError plus diagnostic text.
+The outer direct false property places negative cases in the newly supported
+scope; the discarded nested restriction is independently checked by jsonschema.
+"""
+import json
+
+import pytest
+import xgrammar as xgr
+from jsonschema import Draft202012Validator
+from xgrammar.testing import _is_grammar_accept_string
+
+
+VALUE = {"c": {"z": 1}}
+FORBIDDEN = {"type": "object", "properties": {"z": False}}
+
+
+def compact(value):
+    return json.dumps(value, separators=(",", ":"))
+
+
+def wrap(inner, definitions=None):
+    schema = {"type": "object", "properties": {"new": False, "x": inner},
+              "required": ["x"], "additionalProperties": False}
+    if definitions is not None:
+        schema["$defs"] = definitions
+    return schema
+
+
+def priority_case(keyword, hidden, value=None, definitions=None):
+    value = VALUE if value is None else value
+    defs = dict(definitions or {})
+    inner = {"properties": {"c": hidden}}
+    if keyword == "const":
+        inner["const"] = value
+    elif keyword == "enum":
+        inner["enum"] = [value]
+    elif keyword == "$ref":
+        inner["$ref"] = "#/$defs/value"
+        defs["value"] = {"const": value}
+    elif keyword == "allOf":
+        inner["allOf"] = [{"type": "object", "additionalProperties": True}]
+    else:
+        raise AssertionError(keyword)
+    return wrap(inner, defs), compact({"x": value})
+
+
+def require_unsupported(schema, keyword):
+    Draft202012Validator.check_schema(schema)
+    with pytest.raises(RuntimeError, match=r"(?i)(unsupported|not supported)") as caught:
+        xgr.Grammar.from_json_schema(compact(schema))
+    message = str(caught.value)
+    assert "sibling" in message.lower(), message
+    assert keyword in message, message
+
+
+def require_accept(schema, source):
+    Draft202012Validator.check_schema(schema)
+    assert Draft202012Validator(schema).is_valid(json.loads(source)), source
+    grammar = xgr.Grammar.from_json_schema(compact(schema))
+    assert _is_grammar_accept_string(grammar, source), source
+
+
+@pytest.mark.parametrize("keyword", ["const", "enum", "$ref", "allOf"])
+def test_discarded_nested_false_in_newly_supported_object(keyword):
+    schema, source = priority_case(keyword, FORBIDDEN)
+    assert not Draft202012Validator(schema).is_valid(json.loads(source))
+    require_unsupported(schema, keyword)
+
+
+@pytest.mark.parametrize("keyword", ["const", "enum", "$ref", "allOf"])
+def test_discarded_false_through_local_ref_chain(keyword):
+    schema, source = priority_case(keyword, {"$ref": "#/$defs/first"}, definitions={
+        "first": {"$ref": "#/$defs/second"}, "second": FORBIDDEN})
+    assert not Draft202012Validator(schema).is_valid(json.loads(source))
+    require_unsupported(schema, keyword)
+
+
+@pytest.mark.parametrize("keyword", ["const", "$ref"])
+def test_discarded_cycle_does_not_hide_separate_false_target(keyword):
+    node = {"type": "object", "properties": {
+        "again": {"$ref": "#/$defs/node"}, "target": {"$ref": "#/$defs/forbidden"}}}
+    schema, source = priority_case(keyword, {"$ref": "#/$defs/node"},
+        value={"c": {"target": {"z": 1}}},
+        definitions={"node": node, "forbidden": FORBIDDEN})
+    assert not Draft202012Validator(schema).is_valid(json.loads(source))
+    require_unsupported(schema, keyword)
+
+
+@pytest.mark.parametrize("keyword", ["const", "enum", "$ref", "allOf"])
+def test_discarded_local_ref_cycle_without_false_is_supported(keyword):
+    node = {"type": "object", "properties": {"again": {"$ref": "#/$defs/node"}}}
+    schema, source = priority_case(keyword, {"$ref": "#/$defs/node"},
+                                  value={"c": {"again": {}}}, definitions={"node": node})
+    require_accept(schema, source)
+
+
+@pytest.mark.parametrize("keyword", ["const", "enum", "$ref", "allOf"])
+def test_nonfalse_discarded_sibling_positive_control(keyword):
+    hidden = {"type": "object", "properties": {"z": {"type": "integer"}}}
+    schema, source = priority_case(keyword, hidden)
+    require_accept(schema, source)
+
+
+@pytest.mark.parametrize("keyword", ["const", "enum"])
+def test_literal_data_is_not_a_false_schema(keyword):
+    data = {"properties": {"z": False}, "allOf": [{"properties": {"q": False}}],
+            "$ref": "#/$defs/missing-is-data"}
+    literal = {keyword: data if keyword == "const" else [data]}
+    # Include a discarded real schema sibling to exercise the raw visitor.
+    literal["properties"] = {"properties": {"type": "object"}}
+    schema = wrap(literal)
+    require_accept(schema, compact({"x": data}))
+
+
+@pytest.mark.parametrize("keyword", ["const", "enum"])
+def test_literal_data_in_discarded_descendant_is_not_scanned(keyword):
+    data = {"properties": {"z": False}, "$ref": "#/$defs/not-a-real-ref"}
+    hidden = {keyword: data if keyword == "const" else [data]}
+    schema, source = priority_case("const", hidden, value={"c": data})
+    require_accept(schema, source)
+
+
+@pytest.mark.parametrize("keyword", ["const", "enum", "$ref", "allOf"])
+def test_unused_definitions_with_false_are_not_scanned(keyword):
+    schema, source = priority_case(keyword, {"type": "object"}, definitions={
+        "unused_false": FORBIDDEN,
+        "unused_ref_cycle": {"$ref": "#/$defs/unused_ref_cycle"}})
+    require_accept(schema, source)
+
+
+@pytest.mark.parametrize("keyword", ["const", "enum"])
+def test_unrelated_false_annotation_data_is_not_scanned(keyword):
+    schema, source = priority_case(keyword, {"type": "object"})
+    schema["properties"]["x"].update({
+        "default": {"properties": {"z": False}},
+        "examples": [{"properties": {"z": False}}]})
+    require_accept(schema, source)
+
+
+def test_discarded_root_ref_revisits_selected_false_subtree():
+    schema = {"allOf": [{"type": "object", "properties": {"blocked": False},
+                         "additionalProperties": True}],
+              "properties": {"child": {"$ref": "#"}}}
+    source = '{"child":{"blocked":1}}'
+    assert not Draft202012Validator(schema).is_valid(json.loads(source))
+    require_unsupported(schema, "allOf")
+
+
+def test_discarded_root_ref_without_false_positive_control():
+    schema = {"allOf": [{"type": "object", "properties": {"b": {"type": "integer"}},
+                         "additionalProperties": True}],
+              "properties": {"child": {"$ref": "#"}}}
+    require_accept(schema, '{"child":{"b":1}}')
+
+
+@pytest.mark.parametrize("uri", ["#/$defs/missing",
+                                "https://example.invalid/schema"])
+def test_unresolved_discarded_ref_is_explicit_conservative_boundary(uri):
+    schema = wrap({"const": {}, "properties": {"absent": {"$ref": uri}}})
+    schema["$defs"] = {"a/b": {"type": "integer"}}
+    # No remote dereference: absent is not present in the const object.
+    assert Draft202012Validator(schema).is_valid({"x": {}})
+    require_unsupported(schema, "const")
+
+
+@pytest.mark.parametrize("uri", ["#/$defs/a~1b", "#%2F$defs%2Fa~1b"])
+def test_resolvable_escaped_discarded_ref(uri):
+    schema = wrap({"const": {}, "properties": {"absent": {"$ref": uri}}})
+    schema["$defs"] = {"a/b": {"type": "integer"}}
+    require_accept(schema, '{"x":{}}')
