+import json,os
+from pathlib import Path
+import pytest
+import xgrammar as xgr
+from jsonschema import Draft202012Validator
+from transformers import AutoTokenizer
+from sglang.srt.entrypoints.openai.protocol import Tool
+from sglang.srt.function_call.function_call_parser import FunctionCallParser
+
+@pytest.fixture(scope='module')
+def runtime():
+    os.environ['SGLANG_TOOL_STRICT_LEVEL']='2'
+    tok=AutoTokenizer.from_pretrained('/tokenizer',trust_remote_code=True,local_files_only=True)
+    c=json.loads(Path('/tokenizer/config.json').read_text())
+    info=xgr.TokenizerInfo.from_huggingface(tok,vocab_size=c.get('text_config',c)['vocab_size'],stop_token_ids=[tok.eos_token_id])
+    return tok,info,xgr.GrammarCompiler(info,max_threads=2)
+
+def compiled(runtime,schema):
+    schema=dict(schema)
+    defs=schema.pop('$defs',None)
+    outer={'type':'object','properties':{'payload':schema},'required':['payload'],'additionalProperties':False}
+    if defs is not None:outer['$defs']=defs
+    tool=Tool.model_validate({'type':'function','function':{'name':'probe','parameters':outer,'strict':True}})
+    result=FunctionCallParser([tool],'kimi_k3').get_structure_constraint('required',thinking_mode=False)
+    assert result is not None, 'K3 fixture must produce a structural constraint'
+    constraint=result[1]
+    return runtime[2].compile_structural_tag(constraint)
+
+BASE={'type':'object','properties':{'blocked':False},'additionalProperties':True}
+@pytest.mark.parametrize('schema,keyword',[
+    ({**BASE,'required':['missing']},'required'),
+    ({**BASE,'required':['missing'],'additionalProperties':False},'required'),
+    ({**BASE,'minProperties':2},'minProperties'),
+    ({'allOf':[BASE,{'type':'object'}]},'allOf'),
+    ({'$defs':{'entry':BASE},'allOf':[{'$ref':'#/$defs/entry'},{'type':'object'}]},'allOf'),
+    ({'oneOf':[BASE,{'type':'object'}]},'oneOf'),
+    ({**BASE,'const':{}},'const'),
+])
+def test_k3_unsupported_and_unsatisfiable_fail_before_generation(runtime,schema,keyword):
+    with pytest.raises(RuntimeError) as caught:compiled(runtime,schema)
+    assert keyword.lower() in str(caught.value).lower()
+
+@pytest.mark.parametrize('additional',[False,True])
+@pytest.mark.parametrize('wrap',['direct','ref','single-allof'])
+def test_k3_live_escape_mask_rollback_and_type(runtime,additional,wrap):
+    tok,info,_=runtime
+    leaf={**BASE,'properties':{'blocked':False,'b':{'type':'integer'}},'required':['b'],'additionalProperties':additional}
+    schema=leaf if wrap=='direct' else {'$defs':{'entry':leaf},'$ref':'#/$defs/entry'} if wrap=='ref' else {'allOf':[leaf]}
+    g=compiled(runtime,schema)
+    for source,expected in [('{"b":1}',True),(r'{"\u0062":1}',True),(r'{"\u0062":"wrong"}',False),('{"blocked":1,"b":1}',False),(r'{"b":1,"\u0062":2}',False)]:
+        # Duplicate named keys deliberately exercise the grammar's stronger uniqueness contract.
+        if source!=r'{"b":1,"\u0062":2}':assert Draft202012Validator(schema).is_valid(json.loads(source))==expected
+        wire='<|open|>tools<|sep|><|open|>call tool="probe" index="1"<|sep|><|open|>argument key="payload" type="object"<|sep|>'+source+'<|close|>argument<|sep|><|close|>call<|sep|><|close|>tools<|sep|>'
+        ids=tok.encode(wire,add_special_tokens=False);m=xgr.GrammarMatcher(g);mask=xgr.allocate_token_bitmask(1,info.vocab_size);accepted=True
+        for i,t in enumerate(ids):
+            m.fill_next_token_bitmask(mask);allowed=bool((int(mask[0,t//32])>>(t%32))&1)
+            ok=m.accept_token(t);assert allowed==ok
+            if not ok:accepted=False;break
+            if i>3 and i%7==0:
+                m.rollback(3)
+                for replay in ids[i-2:i+1]:
+                    m.fill_next_token_bitmask(mask);assert (int(mask[0,replay//32])>>(replay%32))&1;assert m.accept_token(replay)
+        assert (accepted and m.is_completed())==expected
