+int32_t EBNFParser::ParseUnorderedMacro() {
+  Consume();
+  auto start = current_token_;
+  auto args = ParseMacroArguments();
+  auto delta = start - current_token_;
+  if (args.arguments.size() < 4) {
+    ReportParseError(
+        "Unordered expects separator, min_count, max_count, and (rule, required) pairs", delta
+    );
+  }
+  auto rule_id = [&](const MacroIR::Node* node) {
+    auto name = std::get_if<MacroIR::IdentifierNode>(node);
+    if (name == nullptr || builder_.GetRuleId(name->name) < 0) {
+      ReportParseError("Unordered requires a defined rule identifier", delta);
+    }
+    return builder_.GetRuleId(name->name);
+  };
+  int separator = rule_id(args.arguments[0].get());
+  auto lower = std::get_if<MacroIR::IntegerNode>(args.arguments[1].get());
+  auto upper = std::get_if<MacroIR::IntegerNode>(args.arguments[2].get());
+  if (lower == nullptr || upper == nullptr || lower->value < 1 || lower->value > upper->value ||
+      upper->value > static_cast<int64_t>(args.arguments.size() - 3)) {
+    ReportParseError("Unordered requires 1 <= min_count <= max_count <= number of entries", delta);
+  }
+  std::vector<std::pair<int32_t, bool>> entries;
+  std::vector<std::pair<int32_t, int32_t>> dependency_rules;
+  for (size_t i = 3; i < args.arguments.size(); ++i) {
+    auto pair = std::get_if<MacroIR::TupleNode>(args.arguments[i].get());
+    if (pair == nullptr || pair->elements.size() != 2) {
+      ReportParseError("Unordered entries must be (rule, required) pairs", delta);
+    }
+    auto required = std::get_if<MacroIR::BooleanNode>(pair->elements[1].get());
+    if (required == nullptr) {
+      dependency_rules.emplace_back(rule_id(pair->elements[0].get()), rule_id(pair->elements[1].get()));
+    } else {
+      entries.emplace_back(rule_id(pair->elements[0].get()), required->value);
+    }
+  }
+  if (upper->value > static_cast<int64_t>(entries.size()))
+    ReportParseError("Unordered maximum exceeds its entry count", delta);
+  std::vector<std::pair<int32_t, int32_t>> dependencies;
+  auto index = [&](int32_t rule) -> int32_t {
+    for (size_t i = 0; i < entries.size(); ++i) if (entries[i].first == rule) return i;
+    ReportParseError("Unordered dependency must name an entry rule", delta);
+    return -1;
+  };
+  for (const auto& [trigger, target] : dependency_rules) dependencies.emplace_back(index(trigger), index(target));
+  int32_t mode = 0, context_minimum = lower->value;
+  std::vector<int32_t> group;
+  for (const auto& [key, value] : args.named_arguments) {
+    if (key == "presence") {
+      auto tuple = std::get_if<MacroIR::TupleNode>(value.get());
+      if (tuple == nullptr) ReportParseError("Presence must be a tuple of entry names", delta);
+      for (const auto& item : tuple->elements) group.push_back(index(rule_id(item.get())));
+    } else if (key == "presence_mode" || key == "context_minimum") {
+      auto number = std::get_if<MacroIR::IntegerNode>(value.get());
+      if (number == nullptr || number->value < 0 || number->value > 64)
+        ReportParseError("Presence metadata must be a bounded integer", delta);
+      if (key == "presence_mode") mode = number->value;
+      else context_minimum = number->value;
+    } else {
+      ReportParseError("Unknown Unordered named argument", delta);
+    }
+  }
+  return builder_.AddUnordered(separator, lower->value, upper->value, std::move(entries), dependencies,
+                                mode, group, context_minimum);
+}
