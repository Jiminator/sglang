+    matcher = xgr.GrammarMatcher(compiled)
+    mask = xgr.allocate_token_bitmask(1,len(pieces))
+    assert matcher.accept_token(0)
+    for first, forbidden, allowed in [(1,3,4),(2,4,3),(1,3,4)]:
+        assert matcher.accept_token(first)
+        matcher.fill_next_token_bitmask(mask)
+        assert not bool((int(mask[0,0]) >> forbidden) & 1)
+        assert bool((int(mask[0,0]) >> allowed) & 1)
+        matcher.rollback(1)
