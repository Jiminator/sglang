+    // Prove only the fixed-codepoint form emitted by JSONSchemaConverter. Do not accept
+    // arbitrary regexes, prefix matches, or a mixture of proven and unproven entries.
+    std::vector<std::vector<uint32_t>> keys;
+    for (int i = 9; i < 9 + 2 * expr[4]; i += 2) {
