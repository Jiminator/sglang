@@ -0,0 +1,169 @@
+"""Synthetic native reference regressions; CPU only, no customer captures."""
+import json
+
+import pytest
+import xgrammar as xgr
+from xgrammar.testing import _is_grammar_accept_string
+
+
+def grammar(schema):
+    return xgr.Grammar.from_json_schema(json.dumps(schema), separators=(",", ":"))
+
+
+@pytest.mark.parametrize("key,ref", [
+    ("a/b", "#/$defs/a~1b"),
+    ("a~b", "#/$defs/a~0b"),
+    ("a~1b", "#/$defs/a~01b"),
+    ("a b", "#/$defs/a%20b"),
+    ("a/b", "#%2F$defs%2Fa~1b"),
+    ("a/b", "#%2f$defs%2fa%7e1b"),
+    ("%2F", "#/$defs/%252F"),
+    ("\u00e9", "#/$defs/%C3%A9"),
+    ("", "#/$defs/"),
+])
+def test_native_pointer_decoding(key, ref):
+    g = grammar({"$defs": {key: {"const": "ok"}}, "$ref": ref})
+    assert _is_grammar_accept_string(g, '"ok"')
+    assert not _is_grammar_accept_string(g, '"wrong"')
+    assert not _is_grammar_accept_string(g, '123')
+
+
+@pytest.mark.parametrize("schema", [
+    {"": {"": {"const": "ok"}}, "$ref": "#//"},
+    {"": {"const": "ok"}, "$ref": "#/"},
+    {"x": [{"const": "wrong"}, {"const": "ok"}], "$ref": "#/x/1"},
+    {"x": [{"": {"const": "ok"}}], "$ref": "#/x/0/"},
+    {"x": {"01": {"const": "ok"}}, "$ref": "#/x/01"},
+])
+def test_native_pointer_empty_and_array_tokens(schema):
+    g = grammar(schema)
+    assert _is_grammar_accept_string(g, '"ok"')
+    assert not _is_grammar_accept_string(g, '"wrong"')
+
+
+@pytest.mark.parametrize("ref", [
+    "#/x/", "#/x/01", "#/x/-1", "#/x/+0", "#/x/-", "#/x/1",
+    "#/x/99999999999999999999999999999999999999999",
+    "#/x/0.0", "#/x/ 0", "#/x/0/no-field",
+    "#/missing", "#/x/%", "#/x/%0", "#/x/%GG", "#/x/~", "#/x/~2",
+    "#anchor", "https://example.invalid/schema", "other.json#/x", "#%GG",
+])
+def test_native_invalid_refs_fail_closed(ref):
+    with pytest.raises(RuntimeError, match="Cannot find|Malformed|Unsupported"):
+        grammar({"x": [{"const": "ok"}], "$ref": ref})
+
+
+@pytest.mark.parametrize("schema", [
+    {"$ref": "#"}, {"$ref": ""},
+    {"$ref": "#/$defs/a", "$defs": {"a": {"$ref": "#/$defs/b"},
+                                       "b": {"$ref": "#/$defs/a"}}},
+    {"$ref": "#/$defs/a", "$defs": {"a": {"$ref": "#%2F$defs%2Fa"}}},
+    {"type": "array", "items": {"$ref": "#/$defs/a"},
+     "$defs": {"a": {"$ref": "#/$defs/a"}}},
+])
+def test_native_pure_ref_cycles_rejected(schema):
+    with pytest.raises(RuntimeError, match=r"Circular \$ref chain"):
+        grammar(schema)
+
+
+@pytest.mark.parametrize("ref", ["#", "", "#/$defs/node"])
+def test_native_consuming_recursion(ref):
+    node = {"type": "object", "properties": {"child": {"$ref": ref}},
+            "additionalProperties": False}
+    schema = ({"$ref": ref, "$defs": {"node": node}}
+              if ref.startswith("#/") else node)
+    g = grammar(schema)
+    for value in ['{}', '{"child":{}}', '{"child":{"child":{}}}']:
+        assert _is_grammar_accept_string(g, value)
+    assert not _is_grammar_accept_string(g, '{"child":1}')
+
+
+def test_native_reference_to_missing_property_refused():
+    schema = {"type": "object", "properties": {"present": {"$ref": "#/properties/absent"}},
+              "required": ["present"]}
+    with pytest.raises(RuntimeError, match="Cannot find field"):
+        grammar(schema)
+
+
+def test_native_guard_follows_escaped_false_constraint():
+    schema = {"const": {}, "properties": {"absent": {"$ref": "#%2F$defs%2Fa~1b"}},
+              "$defs": {"a/b": {"properties": {"blocked": False}}}}
+    with pytest.raises(RuntimeError, match="discard|Discard|false"):
+        grammar(schema)
+
+
+def test_native_nested_id_resource_refused():
+    schema = {"type": "object", "$defs": {"X": {"type": "integer"}},
+              "properties": {"v": {"$id": "https://example.invalid/inner",
+                  "type": "array", "$defs": {"X": {"type": "string"}},
+                  "items": {"$ref": "#/$defs/X"}}}, "required": ["v"]}
+    with pytest.raises(RuntimeError, match=r"Nested \$id schema resources"):
+        grammar(schema)
+
+
+@pytest.mark.parametrize("ref", ["#/$defs/resource/properties/value",
+                                 "#%2F$defs%2Fresource%2Fproperties%2Fvalue"])
+def test_native_pointer_cannot_jump_under_id_resource(ref):
+    schema = {"$defs": {"X": {"type": "integer"}, "resource": {
+        "$id": "https://example.invalid/inner", "type": "object",
+        "$defs": {"X": {"type": "string"}},
+        "properties": {"value": {"$ref": "#/$defs/X"}}}}, "$ref": ref}
+    with pytest.raises(RuntimeError, match=r"Nested \$id schema resources"):
+        grammar(schema)
+
+
+def test_native_unused_id_resource_is_not_scanned():
+    schema = {"type": "integer", "$defs": {"unused": {
+        "$id": "https://example.invalid/unused", "$ref": "#/$defs/missing"}}}
+    g = grammar(schema)
+    assert _is_grammar_accept_string(g, '1')
+    assert not _is_grammar_accept_string(g, '"1"')
+
+
+def test_native_no_id_keeps_original_root_scope():
+    schema = {"$defs": {"X": {"type": "integer"}, "resource": {
+        "type": "object", "$defs": {"X": {"type": "string"}},
+        "properties": {"value": {"$ref": "#/$defs/X"}}}},
+        "$ref": "#/$defs/resource/properties/value"}
+    g = grammar(schema)
+    assert _is_grammar_accept_string(g, '1')
+    assert not _is_grammar_accept_string(g, '"1"')
+
+
+def test_native_root_id_local_reference_remains_supported():
+    g = grammar({"$id": "https://example.invalid/root", "$defs": {"X": {"const": 3}},
+                 "$ref": "#/$defs/X"})
+    assert _is_grammar_accept_string(g, '3')
+    assert not _is_grammar_accept_string(g, '4')
+
+
+def test_native_id_and_ref_literal_data_remain_data():
+    value = {"$id": "literal-data", "$ref": "literal-ref"}
+    g = grammar({"const": value})
+    assert _is_grammar_accept_string(g, json.dumps(value, separators=(",", ":")))
+    assert not _is_grammar_accept_string(g, '{}')
+
+
+def test_native_pointer_through_id_literal_annotation():
+    schema = {"default": {"$id": "literal-data", "target": {"const": 3}},
+              "$ref": "#/default/target"}
+    g = grammar(schema)
+    assert _is_grammar_accept_string(g, '3')
+    assert not _is_grammar_accept_string(g, '4')
+
+
+def test_native_property_named_id_does_not_establish_resource():
+    g = grammar({"type": "object", "properties": {"$id": {"type": "integer"}},
+                 "required": ["$id"], "additionalProperties": False})
+    assert _is_grammar_accept_string(g, '{"$id":1}')
+    assert not _is_grammar_accept_string(g, '{"$id":"1"}')
+
+
+def test_native_discarded_id_resource_cannot_hide_constraint():
+    schema = {"const": {"v": {"blocked": 1}},
+        "$defs": {"X": {"type": "object"}},
+        "properties": {"v": {"$id": "https://example.invalid/inner",
+            "$defs": {"X": {"properties": {"blocked": False}}},
+            "$ref": "#/$defs/X"}}}
+    with pytest.raises(RuntimeError, match="Discarded"):
+        grammar(schema)
