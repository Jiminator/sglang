index 0000000000000000000000000000000000000000..c7de4ae599498669dae961534755c560f28c98c1
--- /dev/null
+++ b/tests/python/test_phala_presence_v2.py
@@ -0,0 +1,117 @@
+"""Native V2 masks checked against independent finite JSON Schema supersets."""
+import itertools
+import json
+
+import pytest
+from jsonschema import Draft202012Validator
+import xgrammar as xgr
+from xgrammar.base import _core
+from xgrammar.structural_tag import ConstStringFormat, SequenceFormat, StructuralTag, TagFormat
+
+
+def native(names, group, mode, dependencies=(), required=(), minimum=0):
+    return StructuralTag(format=TagFormat(begin="[", end="]", content=SequenceFormat(
+        elements=[ConstStringFormat(value=key + ";") for key in names], unordered=True,
+        required=[i in required for i in range(len(names))], min_elements=minimum,
+        dependencies=list(dependencies), presence_mode=mode, presence_indices=list(group))))
+
+
+@pytest.mark.parametrize("dynamic", [False, True])
+def test_exhaustive_prefix_and_close_oracle(dynamic):
+    names = ["d", "a", "c", "b"]
+    pieces = ["["] + [key + ";" for key in names] + ["]", "[EOS]"]
+    info = xgr.TokenizerInfo(pieces, stop_token_ids=6)
+    compiler = xgr.GrammarCompiler(info, max_threads=1, cache_enabled=False, enable_dynamic_compilation=dynamic)
+    for mode, edges, reqbits, minimum, group in itertools.product(
+        ["not_all", "exactly_one"], [[], [(0, 1), (1, 2)], [(0, 1), (1, 0)]],
+        [0, 1, 3], [0, 1, 3, 4], [[0], [0, 1], [0, 1, 2, 3]],
+    ):
+        required = [i for i in range(4) if reqbits & (1 << i)]
+        schema = {"type": "object", "properties": dict.fromkeys(names, True), "additionalProperties": False,
+                  "required": [names[i] for i in required], "minProperties": minimum,
+                  "dependentRequired": {names[i]: [names[j] for a, j in edges if a == i] for i, _ in edges}}
+        if mode == "not_all":
+            schema["not"] = {"required": [names[i] for i in group]}
+        else:
+            schema["oneOf"] = [{"required": [names[i]]} for i in group]
+        validator = Draft202012Validator(schema)
+        valid = [mask for mask in range(16) if validator.is_valid({names[i]: 0 for i in range(4) if mask & (1 << i)})]
+        fmt = native(names, group, mode, edges, required, minimum)
+        if not valid:
+            with pytest.raises(RuntimeError, match="presence_unsatisfiable"):
+                compiler.compile_structural_tag(fmt)
+            continue
+        compiled = compiler.compile_structural_tag(fmt)
+        for selected in range(16):
+            matcher = xgr.GrammarMatcher(compiled)
+            assert matcher.accept_token(0)
+            accepted = all(matcher.accept_token(i + 1) for i in reversed(range(4)) if selected & (1 << i))
+            feasible = any(selected & ~full == 0 for full in valid)
+            assert accepted == feasible, (mode, edges, reqbits, minimum, group, selected)
+            if not feasible:
+                continue
+            mask = xgr.allocate_token_bitmask(1, 7)
+            matcher.fill_next_token_bitmask(mask)
+            actual = {i for i in range(7) if (int(mask[0, 0]) >> i) & 1}
+            expected = {i + 1 for i in range(4) if not selected & (1 << i)
+                        and any((selected | (1 << i)) & ~full == 0 for full in valid)}
+            if selected in valid:
+                expected.add(5)
+            assert actual == expected, (mode, selected, actual, expected)
+            assert matcher.accept_token(5) == (selected in valid)
+
+
+def test_capability_roundtrip_and_64_bit_boundary():
+    assert _core.SupportsUnorderedConstraintsV2()
+    names = [f"k{i:02}" for i in range(64)]
+    grammar = xgr.Grammar.from_structural_tag(native(names, [0, 63], "not_all"))
+    info = xgr.TokenizerInfo(["x", "[EOS]"], stop_token_ids=1)
+    for current in [grammar, xgr.Grammar.from_ebnf(str(grammar)), xgr.Grammar.deserialize_json(grammar.serialize_json())]:
+        compiled = xgr.GrammarCompiler(info).compile_grammar(current)
+        for values, expected in [([63], True), ([0], True), ([63, 0], False), (list(range(1, 64)), True)]:
+            matcher = xgr.GrammarMatcher(compiled)
+            wire = "[" + "".join(names[i] + ";" for i in values) + "]"
+            assert (matcher.accept_string(wire) and matcher.is_completed()) == expected
+    with pytest.raises(RuntimeError, match="version|Version"):
+        xgr.Grammar.deserialize_json(grammar.serialize_json().replace(xgr.get_serialization_version(), "v21-phala-unordered-constraints-v1"))
+
+
+def test_dense_4096_edges_and_explicit_limits():
+    names = [f"k{i:02}" for i in range(64)]
+    edges = list(itertools.product(range(64), repeat=2))
+    fmt = native(names, list(range(64)), "not_all", edges)
+    compiled = xgr.GrammarCompiler(xgr.TokenizerInfo(["[", "]", "k00;", "[EOS]"], stop_token_ids=3)).compile_structural_tag(fmt)
+    matcher = xgr.GrammarMatcher(compiled)
+    assert matcher.accept_token(0)
+    assert not matcher.accept_token(2)
+    assert matcher.accept_token(1) and matcher.is_completed()
+    for bad in [native(names, [0], "not_all", edges + [(0, 1)]),
+                native(names + ["overflow"], [0], "not_all")]:
+        with pytest.raises(RuntimeError, match="presence_resource_limit"):
+            xgr.Grammar.from_structural_tag(bad)
+    raw = native(["a", "b"], [0, 1], "exactly_one").model_dump()
+    raw["format"]["content"]["max_elements"] = 1
+    with pytest.raises(RuntimeError, match="constraining maximum"):
+        xgr.Grammar.from_structural_tag(json.dumps(raw))
+
+
+@pytest.mark.parametrize("dynamic", [False, True])
+def test_rollback_and_cross_boundary_tokens(dynamic):
+    pieces = ["[", "a;", "b;", "c;", "]", "a;b;", "c;b;]", "[EOS]"]
+    fmt = native(["a", "b", "c"], [0, 1], "exactly_one", [(2, 1)])
+    compiler = xgr.GrammarCompiler(xgr.TokenizerInfo(pieces, stop_token_ids=7), enable_dynamic_compilation=dynamic)
+    matcher = xgr.GrammarMatcher(compiler.compile_structural_tag(fmt))
+    assert matcher.accept_token(0)
+    mask = xgr.allocate_token_bitmask(1, len(pieces))
+    matcher.fill_next_token_bitmask(mask)
+    assert not (int(mask[0, 0]) >> 5) & 1
+    assert (int(mask[0, 0]) >> 6) & 1
+    assert matcher.accept_token(1)
+    assert not matcher.accept_token(3)
+    matcher.rollback(1)
+    assert matcher.accept_token(3)
+    matcher.fill_next_token_bitmask(mask)
+    assert {i for i in range(8) if (int(mask[0, 0]) >> i) & 1} == {2}
+    assert matcher.accept_token(2) and matcher.accept_token(4)
+    matcher.reset()
+    assert matcher.accept_token(0) and matcher.accept_token(6)
diff --git a/tests/python/test_phala_safe_false.py b/tests/python/test_phala_safe_false.py
new file mode 100644
index 0000000000000000000000000000000000000000..27f5ee6bed732c1ea25c7a1f8b59ef3b1f9d0d14
--- /dev/null
+++ b/tests/python/test_phala_safe_false.py
@@ -0,0 +1,393 @@
+"""CPU-only semantic regressions. No models, network, tokenizer, or local test execution.
+
+Run this file on the authorized isolated builder against each frozen wheel.
+Unsupported is a compile boundary, never counted as successful string rejection.
+"""
+import json
+
+import pytest
+import xgrammar as xgr
+from jsonschema import Draft202012Validator
+from xgrammar.testing import _is_grammar_accept_string
+
+
+def obj(additional=False, live=False, **kw):
+    properties = {"blocked": False}
+    if live:
+        properties.update(b={"type": "integer"}, c={"type": "string"})
+    return dict(type="object", properties=properties, additionalProperties=additional, **kw)
+
+
+def compile_schema(schema, **options):
+    return xgr.Grammar.from_json_schema(json.dumps(schema, ensure_ascii=False), **options)
+
+
+def check(schema, yes, no, **options):
+    Draft202012Validator.check_schema(schema)
+    validator = Draft202012Validator(schema)
+    grammar = compile_schema(schema, **options)
+    for source in yes:
+        assert validator.is_valid(json.loads(source)), ("invalid positive fixture", source)
+        assert _is_grammar_accept_string(grammar, source), source
+    for source in no:
+        assert not validator.is_valid(json.loads(source)), ("valid negative fixture", source)
+        assert not _is_grammar_accept_string(grammar, source), source
+    return grammar
+
+
+def unsupported(schema, keyword):
+    # The public C++ error boundary exposes RuntimeError, not SchemaErrorType.
+    with pytest.raises(RuntimeError, match=r"(?i)(unsupported|not supported)") as caught:
+        compile_schema(schema)
+    assert keyword.lower() in str(caught.value).lower(), str(caught.value)
+
+
+@pytest.mark.parametrize("live", [False, True])
+@pytest.mark.parametrize("additional", [True, {"type": "integer"}])
+def test_unknown_required_open_is_unsupported(additional, live):
+    unsupported(obj(additional, live, required=["missing"]), "required")
+
+
+@pytest.mark.parametrize("live", [False, True])
+def test_unknown_required_closed_is_unsatisfiable(live):
+    with pytest.raises(RuntimeError, match=r"(?i)(unsatisfiable|required.*(missing|undefined|unknown|not))"):
+        compile_schema(obj(False, live, required=["missing"]))
+
+
+@pytest.mark.parametrize("additional", [False, True, {"type": "integer"}])
+def test_required_forbidden_is_unsatisfiable(additional):
+    with pytest.raises(RuntimeError, match=r"(?i)(unsatisfiable|required.*false)"):
+        compile_schema(obj(additional, True, required=["blocked"]))
+
+
+@pytest.mark.parametrize("additional", [True, {"type": "integer"}])
+@pytest.mark.parametrize("live,required", [(False, []), (True, []), (True, ["b", "c"])])
+def test_open_min_two_is_conservative_boundary(additional, live, required):
+    unsupported(obj(additional, live, minProperties=2, maxProperties=3, required=required),
+                "minProperties")
+
+
+def test_min_two_duplicate_witnesses_are_rejected_at_compile_boundary():
+    s = obj(True, minProperties=2, maxProperties=2)
+    validator = Draft202012Validator(s)
+    assert validator.is_valid(json.loads('{"x":1,"y":2}'))
+    for source in ['{"x":1,"x":2}', r'{"x":1,"\u0078":2}',
+                   r'{"\u0078":1,"x":2}']:
+        assert not validator.is_valid(json.loads(source)), source
+    unsupported(s, "minProperties")
+
+
+@pytest.mark.parametrize("order", ["schema", "unordered"])
+def test_open_min_one_multiple_live_fields(order):
+    check(obj(True, True, minProperties=1, maxProperties=3),
+          ['{"b":1}', r'{"\u0062":1}', '{"c":"s"}', '{"b":1,"c":"s"}',
+           '{"extra":1}', '{"extra":1,"extra":2}'],
+          ['{}', '{"blocked":1}', r'{"\u0062":"wrong"}'], property_order=order)
+
+
+def test_min_one_typed_extra_duplicate_uses_last_value_oracle():
+    check(obj({"type": "integer"}, minProperties=1),
+          ['{"x":1,"x":2}', r'{"x":1,"\u0078":2}'],
+          ['{}', '{"x":1,"x":"bad"}', r'{"x":1,"\u0078":"bad"}'])
+
+
+@pytest.mark.parametrize("additional", [True, {"type": "integer"}])
+def test_open_zero_capacity_still_supported(additional):
+    check(obj(additional, True, minProperties=0, maxProperties=0),
+          ['{}'], ['{"b":1}', '{"x":1}', '{"blocked":1}'])
+
+
+@pytest.mark.parametrize("order", ["schema", "unordered"])
+def test_closed_bounds_and_required_live(order):
+    check(obj(False, True, minProperties=2, maxProperties=2, required=["b", "c"]),
