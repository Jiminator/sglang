+def test_native_masks_transaction_and_rollback():
+    tag = native_fields(["a", "b", "c"], {"a", "b"})
+    pieces = ['<call>', '<arg key="a">1</arg>', '<arg key="b">1</arg>', '<arg key="c">1</arg>',
+              '</call>', '<arg key="a">1</arg><arg key="a">1</arg>', '[EOS]']
+    info = xgr.TokenizerInfo(pieces, stop_token_ids=6)
+    matcher = xgr.GrammarMatcher(xgr.GrammarCompiler(info).compile_structural_tag(tag))
+    mask = xgr.allocate_token_bitmask(1, len(pieces))
+    def allowed():
+        matcher.fill_next_token_bitmask(mask)
+        return {i for i in range(len(pieces)) if (int(mask[0, 0]) >> i) & 1}
+    assert matcher.accept_token(0)
+    assert allowed() == {1, 2, 3}
+    assert allowed() == {1, 2, 3}
+    assert not matcher.accept_token(5)
+    assert allowed() == {1, 2, 3}
+    assert matcher.accept_token(3)
+    assert allowed() == {1, 2}
+    assert matcher.accept_token(2)
+    assert allowed() == {1}
+    matcher.rollback(2)
+    assert allowed() == {1, 2, 3}
+    assert matcher.accept_token(1) and matcher.accept_token(2)
+    assert allowed() == {3, 4}
+    assert matcher.accept_token(4)
+    assert matcher.is_completed()
+    matcher.reset()
+    assert allowed() == {0}
