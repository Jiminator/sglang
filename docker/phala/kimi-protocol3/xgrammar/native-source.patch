+bool EarleyParser::UnorderedCanComplete(const ParserState& state, const GrammarExpr& expr) const {
+  if (state.UnorderedSeenId() < 0) return false;
+  const auto& seen = unordered_states_[state.UnorderedSeenId()];
+  if (seen.count < expr[1] || seen.remaining_required != 0) return false;
+  for (int i = 9 + 2 * expr[4]; i < 9 + 2 * expr[4] + 2 * expr[7]; i += 2) {
+    if (unordered_states_.Contains(state.UnorderedSeenId(), expr[i]) &&
+        !unordered_states_.Contains(state.UnorderedSeenId(), expr[i + 1])) return false;
+  }
+  if (expr[5] != 0) {
+    int selected = 0;
+    const int begin = 9 + 2 * expr[4] + 2 * expr[7];
+    for (int i = begin; i < begin + expr[6]; ++i)
+      selected += unordered_states_.Contains(state.UnorderedSeenId(), expr[i]);
+    if (expr[5] == 1 ? selected == expr[6] : selected != 1) return false;
+  }
+  return true;
+}
+
+bool EarleyParser::UnorderedCanEnter(const ParserState& state, const GrammarExpr& expr, int index)
+    const {
+  int count = 0;
+  int remaining_required = expr[3];
+  if (state.UnorderedSeenId() >= 0) {
+    const auto& seen = unordered_states_[state.UnorderedSeenId()];
+    if (index >= 0 && unordered_states_.Contains(state.UnorderedSeenId(), index)) return false;
+    count = seen.count;
+    remaining_required = seen.remaining_required;
+  }
+  if (count >= expr[2]) return false;
+  if (expr[5] != 0 && index >= 0) {
+    const uint64_t selected = (state.UnorderedSeenId() < 0 ? 0 :
+        unordered_states_[state.UnorderedSeenId()].first_word) | (uint64_t{1} << index);
+    bool feasible = false;
+    for (int i = 9 + 2 * expr[4] + 2 * expr[7] + expr[6]; i < expr.size(); i += 2) {
+      const uint64_t allowed = static_cast<uint32_t>(expr[i]) |
+          (uint64_t{static_cast<uint32_t>(expr[i + 1])} << 32);
+      if ((selected & ~allowed) == 0) { feasible = true; break; }
+    }
+    if (!feasible) return false;
+  }
+  // Do not allow an optional field to consume the last slot needed by a required field.
+  return index < 0 || expr[10 + 2 * index] || count + remaining_required < expr[2];
+}
