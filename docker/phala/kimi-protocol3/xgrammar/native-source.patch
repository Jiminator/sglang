+++ b/tests/python/test_phala_false_properties.py
@@ -0,0 +1,154 @@
+"""Independent literal-false regression; run only on authorized isolated CPU builder."""
+import json
+
+import pytest
+import xgrammar as xgr
+from jsonschema import Draft202012Validator
+from xgrammar.testing import _is_grammar_accept_string
+
+
+def schema(properties=None, additional=False, **keywords):
+    return dict(type="object", properties=properties or {"a": False},
+                additionalProperties=additional, **keywords)
+
+
+def check(s, accepted, rejected, **options):
+    grammar = xgr.Grammar.from_json_schema(json.dumps(s), **options)
+    oracle = Draft202012Validator(s)
+    for source in accepted:
+        oracle.validate(json.loads(source))
+        assert _is_grammar_accept_string(grammar, source), source
+    for source in rejected:
+        assert not oracle.is_valid(json.loads(source)), source
+        assert not _is_grammar_accept_string(grammar, source), source
+
+
+@pytest.mark.parametrize("order", ["schema", "unordered"])
+def test_closed_all_false_and_live(order):
+    check(schema(), ["{}"], ['{"a":1}', '{"b":1}', r'{"\u0061":1}'],
+          property_order=order)
+    check(schema({"a": False, "b": {"type": "integer"}}),
+          ["{}", '{"b":1}'], ['{"a":1}', '{"b":"x"}', '{"c":1}'],
+          property_order=order)
+    check(schema({"a": False, "b": {"type": "integer"}}, required=["b"]),
+          ['{"b":1}'], ["{}", '{"a":1,"b":1}'], property_order=order)
+
+
+@pytest.mark.parametrize("additional", [False, True, {"type": "integer"}])
+def test_required_false_stays_unsatisfiable(additional):
+    with pytest.raises(Exception, match="(?i)(false|unsatisfiable)"):
+        xgr.Grammar.from_json_schema(json.dumps(schema(additional=additional, required=["a"])))
+
+
+@pytest.mark.parametrize("properties,minimum", [
+    ({"a": False}, 1), ({"a": False, "b": {"type": "integer"}}, 2)])
+def test_closed_capacity_counts_only_live(properties, minimum):
+    with pytest.raises(Exception, match="(?i)(minProperties|unsatisfiable)"):
+        xgr.Grammar.from_json_schema(json.dumps(schema(properties, minProperties=minimum)))
+
+
+def test_closed_bounds():
+    check(schema(maxProperties=0), ["{}"], ['{"a":1}'])
+    check(schema({"a": False, "b": {"type": "integer"}}, minProperties=1, maxProperties=1),
+          ['{"b":1}'], ["{}", '{"a":1}', '{"a":1,"b":1}'])
+    check(schema({"a": False, "b": {"type": "integer"}}, maxProperties=5),
+          ["{}", '{"b":1}'], ['{"a":1}'])
+
+
+def test_open_all_false():
+    check(schema(additional=True), ["{}", '{"b":1}', '{"aa":1}', '{"":1}'],
+          ['{"a":1}', r'{"\u0061":1}'])
+
+
+@pytest.mark.parametrize("indent,separators", [(2, None), (None, (",", ":"))])
+def test_nested_additional_formatting(indent, separators):
+    s = schema(additional={"type": "object", "properties": {"n": {"type": "integer"}},
+                           "required": ["n"], "additionalProperties": False})
+    serialize = lambda obj: json.dumps(obj, indent=indent, separators=separators)
+    check(s, [serialize({"x": {"n": 1}})], [serialize({"a": {"n": 1}})],
+          any_whitespace=False, indent=indent, separators=separators)
+
+
+def test_open_zero_capacity():
+    check(schema(additional=True, maxProperties=0), ["{}"], ['{"a":1}', '{"b":1}'])
+
+
+def test_open_live_key_not_reopened():
+    check(schema({"a": False, "b": {"type": "integer"}}, additional=True),
+          ["{}", '{"b":1}', '{"c":true}', '{"b":1,"c":true}'],
+          ['{"a":1}', r'{"\u0061":1}', '{"b":"x"}', r'{"\u0062":"x"}'])
+
+
+def test_open_typed_values_and_bounds():
+    check(schema(additional={"type": "integer"}, minProperties=1, maxProperties=1),
+          ['{"c":1}'], ["{}", '{"c":"x"}', '{"a":1}', '{"c":1,"d":2}'])
+
+
+def test_unevaluated_typed_values():
+    s = {"type": "object", "properties": {"a": False},
+         "unevaluatedProperties": {"type": "integer"}}
+    check(s, ["{}", '{"c":1}'], ['{"c":"x"}', '{"a":1}', r'{"\u0061":1}'])
+
+
+@pytest.mark.parametrize("name,spellings", [
+    ("", ['""']),
+    ("\x00", [r'"\u0000"']),
+    ("a", ['"a"', r'"\u0061"']),
+    ("é", ['"é"', r'"\u00e9"', r'"\u00E9"']),
+    ("中", ['"中"', r'"\u4e2d"', r'"\u4E2D"']),
+    ("😀", ['"😀"', r'"\ud83d\ude00"', r'"\uD83D\uDE00"']),
+    ('"', [r'"\""', r'"\u0022"']),
+    ("\\", [r'"\\"', r'"\u005c"', r'"\u005C"']),
+    ("/", ['"/"', r'"\/"', r'"\u002f"']),
+    ("\n", [r'"\n"', r'"\u000a"', r'"\u000A"']),
+    ("a😀/", ['"a😀/"', r'"\u0061\ud83d\ude00\/"']),
+])
+def test_decoded_name_exclusion(name, spellings):
+    check(schema({name: False}, additional=True),
+          ["{}", json.dumps({name + "x": 1}), '{"other":1}'],
+          ["{" + spelling + ":1}" for spelling in spellings])
+
+
+def test_prefixes_and_empty_name():
+    check(schema({"": False, "a": False, "ab": False}, additional=True),
+          ["{}", '{"ac":1}', '{"abc":1}'],
+          ['{"":1}', '{"a":1}', '{"ab":1}', r'{"a\u0062":1}'])
+
+
+@pytest.mark.parametrize("extra", [
+    {"patternProperties": {"^a$": {"type": "integer"}}},
+    {"patternProperties": {".*": True}},
+    {"propertyNames": {"enum": ["a", "b"]}},
+])
+@pytest.mark.parametrize("live", [False, True])
+def test_cross_keyword_explicitly_unsupported(extra, live):
+    props = {"a": False}
+    if live:
+        props["b"] = {"type": "integer"}
+    with pytest.raises(Exception, match="(?i)(not supported|unsupported)"):
+        xgr.Grammar.from_json_schema(json.dumps(schema(props, additional=True, **extra)))
+
+
+def test_empty_pattern_properties_does_not_reopen():
+    check(schema(additional=True, patternProperties={}), ["{}", '{"b":1}'], ['{"a":1}'])
+
+
+def test_malformed_pattern_properties_is_error():
+    with pytest.raises(Exception, match="(?i)(patternProperties|invalid|unsupported)"):
+        xgr.Grammar.from_json_schema(json.dumps(schema(patternProperties=[])))
+
+
+def test_nested_object():
+    nested = schema(additional=True)
+    check(schema({"nested": nested}), ["{}", '{"nested":{}}', '{"nested":{"b":1}}'],
+          ['{"nested":{"a":1}}', r'{"nested":{"\u0061":1}}'])
+
+
+def test_no_false_control():
+    check(schema({"b": {"type": "integer"}}, required=["b"]),
+          ['{"b":1}'], ["{}", '{"b":"x"}', '{"c":1}'])
+
+
+def test_non_false_parse_errors_not_swallowed():
+    with pytest.raises(Exception):
+        xgr.Grammar.from_json_schema(json.dumps(schema({"a": False, "b": {"type": "invalid"}})))
diff --git a/tests/python/test_phala_finite_object_constraints.py b/tests/python/test_phala_finite_object_constraints.py
new file mode 100644
index 0000000000000000000000000000000000000000..af380db95f11f7e54af2af3bbb59b17d0f8173fc
--- /dev/null
+++ b/tests/python/test_phala_finite_object_constraints.py
@@ -0,0 +1,123 @@
+"""Finite unordered constraints: independent truth table and live prefix controls."""
+import itertools
+import json
+
+import pytest
+import xgrammar as xgr
+from xgrammar.base import _core
+from xgrammar.structural_tag import ConstStringFormat, SequenceFormat, StructuralTag, TagFormat
+
+
+def tag(names, required=(), minimum=0, maximum=None, dependencies=()):
+    return StructuralTag(format=TagFormat(begin="[", end="]", content=SequenceFormat(
+        unordered=True, elements=[ConstStringFormat(value=name + ";") for name in names],
+        required=[name in required for name in names], min_elements=minimum,
+        max_elements=maximum, dependencies=list(dependencies))))
+
+
+def compile_tag(value, pieces=None, dynamic=False):
+    pieces = pieces or ["x", "[EOS]"]
+    compiler = xgr.GrammarCompiler(xgr.TokenizerInfo(pieces, stop_token_ids=len(pieces)-1),
+                                   enable_dynamic_compilation=dynamic)
+    return compiler.compile_structural_tag(value)
+
+
+def accepts(compiled, names):
+    matcher = xgr.GrammarMatcher(compiled)
+    return matcher.accept_string("[" + "".join(name + ";" for name in names) + "]") and matcher.is_completed()
+
+
+@pytest.mark.parametrize("minimum,maximum,required,deps", [
+    (0, 0, (), ()), (0, 2, (), ()), (2, 3, ("c",), ()),
+    (0, None, (), ((0, 1),)), (2, None, (), ((0, 1), (1, 2))),
+    (1, None, ("a",), ((0, 1), (1, 2))),
+    (1, None, (), ((0, 1), (1, 0))),
+])
+def test_independent_exhaustive_permutations(minimum, maximum, required, deps):
+    names = ["c", "a", "b", "d"]  # deliberately not lexical order
+    compiled = compile_tag(tag(names, required, minimum, maximum, deps))
+    for size in range(5):
+        for order in itertools.permutations(names, size):
+            selected = set(order)
+            expected = minimum <= size <= (4 if maximum is None else maximum)
+            expected &= set(required).issubset(selected)
+            expected &= all(names[a] not in selected or names[b] in selected for a, b in deps)
+            assert accepts(compiled, order) == expected, order
+    assert not accepts(compiled, ["a", "a"])
+
+
+def test_capability_and_grammar_roundtrip():
+    assert _core.SupportsUnorderedConstraintsV1()
+    grammar = xgr.Grammar.from_structural_tag(tag(["z", "a", "m"], dependencies=[(0, 1), (1, 2)]))
+    reparsed = xgr.Grammar.from_ebnf(str(grammar))
+    restored = xgr.Grammar.deserialize_json(grammar.serialize_json())
+    with pytest.raises(RuntimeError, match="version|Version"):
+        xgr.Grammar.deserialize_json(grammar.serialize_json().replace(xgr.get_serialization_version(), "v21"))
+    compiler = xgr.GrammarCompiler(xgr.TokenizerInfo(["x", "[EOS]"], stop_token_ids=1))
+    for current in [grammar, reparsed, restored]:
+        compiled = compiler.compile_grammar(current)
+        assert accepts(compiled, ["m", "z", "a"])
+        assert not accepts(compiled, ["z", "a"])
+
+
+@pytest.mark.parametrize("dynamic", [False, True])
+def test_masks_rollback_and_no_completion_dead_end(dynamic):
+    names = ["c", "a", "b"]
+    pieces = ["[", "c;", "a;", "b;", "]", "c;a;]", "[EOS]"]
+    compiled = compile_tag(tag(names, minimum=1, dependencies=[(0, 1), (1, 2)]), pieces, dynamic)
+    matcher = xgr.GrammarMatcher(compiled)
+    mask = xgr.allocate_token_bitmask(1, len(pieces))
+    def allowed():
+        matcher.fill_next_token_bitmask(mask)
+        return {i for i in range(len(pieces)) if (int(mask[0, 0]) >> i) & 1}
+    assert matcher.accept_token(0)
+    assert allowed() == {1, 2, 3}
+    assert matcher.accept_token(1)
+    assert allowed() == {2, 3}
+    assert not matcher.accept_token(4)
+    assert matcher.accept_token(3)
+    assert allowed() == {2}
+    matcher.rollback(2)
+    assert allowed() == {1, 2, 3}
+    assert matcher.accept_token(2)
+    assert allowed() == {1, 3}
+    assert matcher.accept_token(3)
+    assert allowed() == {1, 4}
+    assert matcher.accept_token(4)
+    assert matcher.is_completed()
+    matcher.reset()
+    assert allowed() == {0}
+
+
+def test_count_reserves_required_slots():
+    pieces = ["[", "a;", "b;", "c;", "]", "[EOS]"]
+    compiled = compile_tag(tag(["a", "b", "c"], required=["a"], maximum=1), pieces)
+    matcher = xgr.GrammarMatcher(compiled)
+    assert matcher.accept_token(0)
+    mask = xgr.allocate_token_bitmask(1, len(pieces))
+    matcher.fill_next_token_bitmask(mask)
+    assert {i for i in range(len(pieces)) if (int(mask[0, 0]) >> i) & 1} == {1}
+
+
+@pytest.mark.parametrize("changes", [
+    {"min_elements": -1}, {"min_elements": True}, {"max_elements": 1.5},
+    {"min_elements": 3}, {"min_elements": 2, "max_elements": 1},
+    {"dependencies": [[0, 2]]}, {"dependencies": [[0, True]]},
+    {"dependencies": [[0, 1]], "max_elements": 1},
+    {"required": [True, True], "max_elements": 1},
+])
+def test_invalid_constraints_refuse(changes):
+    raw = tag(["a", "b"]).model_dump()
+    raw["format"]["content"].update(changes)
+    with pytest.raises(RuntimeError):
+        xgr.Grammar.from_structural_tag(json.dumps(raw))
+
+
+def test_large_dependency_cycle_is_linear_source():
+    names = [f"p{i:03}" for i in range(65)]
+    value = tag(names, minimum=32, dependencies=[(i, (i+1) % 65) for i in range(65)])
+    grammar = xgr.Grammar.from_structural_tag(value)
+    assert len(str(grammar)) < 100000
+    compiled = compile_tag(value)
+    assert accepts(compiled, names[::-1])
+    assert not accepts(compiled, names[:-1])
