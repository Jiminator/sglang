+def test_unordered_reused_string_rule_after_rollback():
+    elements = [TagFormat(begin=f'<arg key="{k}">', end='</arg>',
+                          content=JSONSchemaFormat(json_schema={"type":"string"}, property_order="unordered"))
+                for k in 'abc']
+    tag = StructuralTag(format=TagFormat(begin='<call>', end='</call>', content=SequenceFormat(
+        unordered=True, required=[True,True,True], elements=elements)))
+    pieces = ['<call>', '<arg key="a">"', '<arg key="b">"',
