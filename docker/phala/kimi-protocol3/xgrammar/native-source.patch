+int32_t GrammarBuilder::AddUnordered(
+    int32_t separator_rule,
+    int32_t min_count,
+    int32_t max_count,
+    std::vector<std::pair<int32_t, bool>> entries,
+    const std::vector<std::pair<int32_t, int32_t>>& dependencies,
+    int32_t presence_mode, const std::vector<int32_t>& presence_indices, int32_t context_minimum
+) {
+  XGRAMMAR_CHECK(
+      min_count >= 1 && max_count >= min_count && max_count <= static_cast<int32_t>(entries.size())
+  ) << "Unordered requires 1 <= min_count <= max_count <= number of entries";
+  const int32_t n = entries.size();
+  // Dependencies plus a constraining maximum need completion feasibility, not
+  // merely an end predicate. This version deliberately supports the min-only case.
+  XGRAMMAR_CHECK(dependencies.empty() || max_count == n)
+      << "Unordered dependencies with a constraining maximum are unsupported";
+  XGRAMMAR_CHECK(presence_mode >= 0 && presence_mode <= 2) << "Invalid presence mode";
+  XGRAMMAR_CHECK(presence_mode != 0 || presence_indices.empty()) << "Presence indices require a mode";
+  if (presence_mode != 0) {
+    XGRAMMAR_CHECK(n <= 64 && dependencies.size() <= 4096 && !presence_indices.empty() && presence_indices.size() <= 64)
+        << "presence_resource_limit: at most 64 entries/group indices and 4096 dependency edges";
+    XGRAMMAR_CHECK(max_count == n) << "Presence constraints with a constraining maximum are unsupported";
+    auto unique_group = presence_indices;
+    std::sort(unique_group.begin(), unique_group.end());
+    XGRAMMAR_CHECK(std::adjacent_find(unique_group.begin(), unique_group.end()) == unique_group.end())
+        << "Presence group indices must be unique";
+    for (int index : presence_indices) XGRAMMAR_CHECK(index >= 0 && index < n) << "Presence index is out of range";
+  }
+  if (context_minimum < 0) context_minimum = min_count;
+  XGRAMMAR_CHECK(context_minimum >= 0 && context_minimum <= min_count) << "Invalid presence context minimum";
+  auto original = entries;
+  for (const auto& [trigger, target] : dependencies) {
+    XGRAMMAR_CHECK(trigger >= 0 && trigger < n && target >= 0 && target < n)
+        << "Unordered dependency index is out of range";
+  }
+  bool changed = true;
+  while (changed) {
+    changed = false;
+    for (const auto& [trigger, target] : dependencies) {
+      if (entries[trigger].second && !entries[target].second) {
+        entries[target].second = true;
+        changed = true;
+      }
+    }
+  }
+  std::sort(entries.begin(), entries.end());
+  std::vector<int32_t> remap(n);
+  for (int i = 0; i < n; ++i) {
+    remap[i] = std::lower_bound(entries.begin(), entries.end(),
+        std::pair<int32_t, bool>{original[i].first, false}) - entries.begin();
+  }
+  std::vector<int32_t> data{separator_rule, min_count, max_count, 0, n, presence_mode,
