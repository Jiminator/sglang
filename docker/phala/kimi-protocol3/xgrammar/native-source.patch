+          if (!SemanticKeyPrefix(child, stage, key)) return false;
+          if (*stage == 3) return true;
+        }
+        return true;
+      case Type::kByteString:
+        if (*stage == 0 && expr.size() == 1 && expr[0] == '"') {
+          *stage = 1;
+          return true;
+        }
+        if (*stage == 2 && expr.size() > 0 && expr[0] == '"') {
+          *stage = 3;
+          return true;
+        }
+        return false;
+      case Type::kRegex: {
+        if (*stage != 1 || expr.size() < 1 || expr[0] != 1) return false;
+        auto pattern = grammar_->GetRegexString(expr);
+        for (size_t pos = 0; pos < pattern.size();) {
+          if (pattern[pos++] != '\\' || pos == pattern.size()) return false;
+          char kind = pattern[pos++];
+          size_t digits = kind == 'u' ? 4 : kind == 'U' ? 8 : 0;
+          if (digits == 0 || pattern.size() - pos < digits) return false;
+          uint32_t cp = 0;
+          for (size_t j = 0; j < digits; ++j) {
+            char c = pattern[pos++];
+            int hex = c >= '0' && c <= '9' ? c - '0' :
+                      c >= 'a' && c <= 'f' ? c - 'a' + 10 :
