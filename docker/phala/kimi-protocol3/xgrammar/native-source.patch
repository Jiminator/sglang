+"""CPU-only regression for the strict unordered-field port (no model loading)."""
+import itertools
+import json
+
+import pytest
+import xgrammar as xgr
+from xgrammar.structural_tag import JSONSchemaFormat, SequenceFormat, TagFormat, StructuralTag
+
+
+def accepts(grammar, text):
+    compiler = xgr.GrammarCompiler(xgr.TokenizerInfo(["x", "[EOS]"], stop_token_ids=1))
+    matcher = xgr.GrammarMatcher(compiler.compile_grammar(grammar))
+    return matcher.accept_string(text) and matcher.is_completed()
+
+
+def native_fields(names, required):
+    return StructuralTag(format=TagFormat(begin="<call>", end="</call>", content=SequenceFormat(
+        unordered=True,
+        required=[name in required for name in names],
+        elements=[TagFormat(begin=f'<arg key="{name}">', end="</arg>",
+                            content=JSONSchemaFormat(json_schema={"type": "integer"},
+                                                     property_order="unordered"))
+                  for name in names],
+    )))
+
+
+def native_text(names):
+    return '<call>' + ''.join(f'<arg key="{name}">1</arg>' for name in names) + '</call>'
+
+
+@pytest.mark.parametrize("count", [3, 8, 9, 14, 65])
+def test_native_optional_required_and_unbounded_field_count(count):
+    names = [f"p{i}" for i in range(count)]
+    grammar = xgr.Grammar.from_structural_tag(native_fields(names, {names[0], names[-1]}))
+    for order in (names, names[::-1], names[1:] + names[:1]):
+        assert accepts(grammar, native_text(order))
+    assert accepts(grammar, native_text([names[-1], names[0]]))
+    assert not accepts(grammar, native_text(names[1:]))
+    assert not accepts(grammar, native_text(names + [names[0]]))
+    assert len(str(grammar)) < count * 1500
+
+
+def test_native_all_optional_and_invalid_metadata():
+    grammar = xgr.Grammar.from_structural_tag(native_fields(["a", "b"], set()))
+    for names in ([], ["a"], ["b"], ["b", "a"]):
+        assert accepts(grammar, native_text(names))
+    assert not accepts(grammar, native_text(["b", "b"]))
+    raw = native_fields(["a"], {"a"}).model_dump()
+    raw["format"]["content"]["required"] = []
+    with pytest.raises(RuntimeError, match="required flag"):
+        xgr.Grammar.from_structural_tag(json.dumps(raw))
+
