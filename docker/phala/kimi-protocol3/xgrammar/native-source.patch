+def test_native_and_nested_six_by_six():
+    inner = {"type": "object", "properties": {k: {"type": "integer"} for k in "xyz"},
+             "required": list("xy"), "additionalProperties": False}
+    tag = StructuralTag(format=TagFormat(begin="<call>", end="</call>", content=SequenceFormat(
+        unordered=True, required=[True, True, True],
+        elements=[TagFormat(begin=f'<arg key="{k}">', end="</arg>",
+                            content=JSONSchemaFormat(json_schema=inner, property_order="unordered"))
+                  for k in "abc"])))
+    grammar = xgr.Grammar.from_structural_tag(tag)
+    for outer, nested in itertools.product(itertools.permutations("abc"), itertools.permutations("xyz")):
+        value = json.dumps({k: 1 for k in nested})
+        text = '<call>' + ''.join(f'<arg key="{k}">{value}</arg>' for k in outer) + '</call>'
+        assert accepts(grammar, text)
