+                     stage == 3)
+          << "Unordered entries require nonempty, nonoverlapping literal prefixes or distinct fixed JSON keys";
+      keys.push_back(std::move(key));
+    }
+    std::sort(keys.begin(), keys.end());
+    XGRAMMAR_CHECK(std::adjacent_find(keys.begin(), keys.end()) == keys.end())
+        << "Unordered entries require distinct fixed JSON keys";
+  }
+
+ private:
+  using Prefix = std::pair<std::string, bool>;
+
+  bool SemanticKeyPrefix(int32_t id, int* stage, std::vector<uint32_t>* key) {
+    RecursionGuard guard(&recursion_depth_);
+    auto expr = grammar_->GetGrammarExpr(id);
+    using Type = Grammar::Impl::GrammarExprType;
+    if (*stage == 3) return true;
+    switch (expr.type) {
+      case Type::kEmptyStr:
+        return true;
+      case Type::kRuleRef: {
+        const auto& rule = grammar_->GetRule(expr[0]);
+        if (rule.is_lazy || rule.json_string_min_length >= 0) return false;
+        return SemanticKeyPrefix(rule.body_expr_id, stage, key);
