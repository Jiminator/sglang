+def _strict_order_grammar(schema, style="json"):
+    return xgr.Grammar.from_structural_tag(
+        xgr.StructuralTag(
+            format=xgr.structural_tag.JSONSchemaFormat(
+                json_schema=schema, style=style, property_order="unordered"
+            )
+        )
+    )
+
